@inject AuthenticationStateService AuthService
@implements IDisposable

<div class="p-4 border rounded-4" style="background: rgba(168, 85, 247, 0.05); border-color: var(--border-color) !important; color: var(--text-primary);">
    <h5>👤 Component 2: User Profile Display</h5>
    <p class="text-secondary small">This sub-component reactively displays information based on the shared authentication service.</p>
    <hr style="border-color: var(--border-color);" />

    @if (AuthService.IsAuthenticated)
    {
        <div class="alert-premium alert-success animate-fade-in my-2">
            <span>👤</span>
            <div>
                <strong>Welcome Back, Authenticated User!</strong><br />
                Your credentials are valid. You are currently logged in.
            </div>
        </div>
    }
    else
    {
        <div class="alert-premium alert-danger animate-fade-in my-2">
            <span>🔒</span>
            <div>
                <strong>Authentication Required</strong><br />
                Please log in to view secure profile information.
            </div>
        </div>
    }
</div>

@code {
    protected override void OnInitialized()
    {
        AuthService.OnChange += StateHasChanged;
    }

    public void Dispose()
    {
        AuthService.OnChange -= StateHasChanged;
    }
}
