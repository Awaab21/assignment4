@page "/"
@rendermode InteractiveServer
@inject TodoDbContext DbContext
@using Microsoft.EntityFrameworkCore

<PageTitle>App 8: Database To-Do List</PageTitle>

<div class="glass-card animate-fade-in">
    <h2>✅ Application 03 & 08: Database-Backed To-Do List</h2>
    <p class="text-secondary">Manage tasks with live synchronization to MS SQL Server LocalDB via Entity Framework Core.</p>

    <!-- Task Input Form -->
    <div class="form-group d-flex gap-2 mt-4">
        <input type="text" class="form-control" @bind="newTaskTitle" @bind:event="oninput" @onkeyup="HandleKeyUp" placeholder="Enter a new task here..." />
        <button class="btn-premium" @onclick="AddTask" disabled="@string.IsNullOrWhiteSpace(newTaskTitle)">
            Add Task
        </button>
    </div>

    <!-- Tasks List Display -->
    <div class="mt-4">
        <h4>Task List (One-Way Bound Display)</h4>
        <hr class="my-2" style="border-color: var(--border-color);" />

        @if (tasks == null)
        {
            <p class="text-muted">Loading tasks from local database...</p>
        }
        else if (tasks.Count == 0)
        {
            <div class="alert-premium alert-info">
                <span>ℹ️</span>
                <div>No tasks found. Try typing a task name and clicking "Add Task"!</div>
            </div>
        }
        else
        {
            <div class="task-list">
                @foreach (var task in tasks)
                {
                    <div class="task-item @(task.IsCompleted ? "completed" : "")">
                        <div class="d-flex align-items-center gap-3">
                            <input type="checkbox" checked="@task.IsCompleted" @onchange="() => ToggleTask(task)" class="todo-checkbox" />
                            <span class="task-title">@task.Title</span>
                        </div>
                        <div class="d-flex align-items-center gap-2">
                            <span class="badge-premium @(task.IsCompleted ? "badge-success" : "badge-info")">
                                @(task.IsCompleted ? "Completed" : "Pending")
                            </span>
                            <button class="btn btn-sm btn-outline-danger" @onclick="() => DeleteTask(task)" style="border-radius: 8px;">
                                🗑️
                            </button>
                        </div>
                    </div>
                }
            </div>

            <div class="d-flex justify-content-between align-items-center mt-3">
                <span class="text-secondary font-weight-500">Total Tasks: @tasks.Count | Completed: @tasks.Count(t => t.IsCompleted)</span>
                <button class="btn-danger-premium" @onclick="ClearAllTasks">
                    ⚠️ Clear All
                </button>
            </div>
        }
    </div>

    <div class="concept-card mt-4">
        <h4>📚 Local DB & State Sync Features</h4>
        <hr class="my-2" style="border-color: var(--border-color);" />
        <ul>
            <li><strong>Two-Way Binding:</strong> Synchronizes input text to C# property <code>newTaskTitle</code>.</li>
            <li><strong>One-Way Binding:</strong> Loops over and binds to HTML to display the tasks.</li>
            <li><strong>LocalDB Integration (MSSQLLocalDB):</strong> Synchronizes Add, Toggle, Delete, and Clear All actions directly into the local SQL Server database using Entity Framework Core.</li>
        </ul>
    </div>
</div>

@code {
    private List<TodoTask>? tasks;
    private string newTaskTitle = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        await LoadTasks();
    }

    private async Task LoadTasks()
    {
        tasks = await DbContext.TodoTasks.OrderByDescending(t => t.CreatedAt).ToListAsync();
    }

    private async Task AddTask()
    {
        if (!string.IsNullOrWhiteSpace(newTaskTitle))
        {
            var task = new TodoTask
            {
                Title = newTaskTitle.Trim(),
                IsCompleted = false,
                CreatedAt = DateTime.UtcNow
            };
            
            DbContext.TodoTasks.Add(task);
            await DbContext.SaveChangesAsync();
            newTaskTitle = string.Empty;
            await LoadTasks();
        }
    }

    private async Task ToggleTask(TodoTask task)
    {
        task.IsCompleted = !task.IsCompleted;
        DbContext.TodoTasks.Update(task);
        await DbContext.SaveChangesAsync();
        await LoadTasks();
    }

    private async Task DeleteTask(TodoTask task)
    {
        DbContext.TodoTasks.Remove(task);
        await DbContext.SaveChangesAsync();
        await LoadTasks();
    }

    private async Task ClearAllTasks()
    {
        var allTasks = await DbContext.TodoTasks.ToListAsync();
        DbContext.TodoTasks.RemoveRange(allTasks);
        await DbContext.SaveChangesAsync();
        await LoadTasks();
    }

    private async Task HandleKeyUp(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await AddTask();
        }
    }
}
