@inject NotificationService NotificationService
@inject NotificationConfig Config
@implements IDisposable

<div class="p-4 border rounded-4" style="background: rgba(14, 165, 233, 0.05); border-color: var(--border-color) !important;">
    <div class="d-flex justify-content-between align-items-center mb-2">
        <h5 class="mb-0">🔔 Component 2: Notifications Display</h5>
        <span class="badge-premium badge-info font-weight-600">Style: @Config.NotificationStyle</span>
    </div>
    <p class="text-secondary small">Loaded dynamically from the injected NotificationService.</p>
    <hr style="border-color: var(--border-color);" />

    @if (notifications == null)
    {
        <p class="text-muted">Fetching notifications...</p>
    }
    else if (notifications.Count == 0)
    {
        <div class="alert-premium alert-info py-2 my-2 w-100">
            No notifications available. Set default count greater than 0.
        </div>
    }
    else if (Config.NotificationStyle == "Compact")
    {
        <ul class="list-group list-group-flush rounded-3 overflow-hidden" style="background: transparent;">
            @foreach (var note in notifications)
            {
                <li class="list-group-item d-flex justify-content-between align-items-center bg-transparent" style="border-color: var(--border-color); color: var(--text-primary);">
                    <div class="d-flex align-items-center gap-2">
                        <span class="badge-premium @GetCategoryBadge(note.Category)">●</span>
                        <span class="font-weight-500">@note.Title</span>
                    </div>
                    <span class="text-muted small">@note.Timestamp.ToString("hh:mm tt")</span>
                </li>
            }
        </ul>
    }
    else
    {
        <!-- Detailed View -->
        <div class="d-flex flex-column gap-3">
            @foreach (var note in notifications)
            {
                <div class="card p-3 border-0 rounded-3 shadow-sm" style="background: var(--input-bg); border: 1px solid var(--border-color) !important; color: var(--text-primary);">
                    <div class="d-flex justify-content-between align-items-center mb-1">
                        <span class="badge-premium @GetCategoryBadge(note.Category)">@note.Category</span>
                        <span class="text-muted small">@note.Timestamp.ToString("hh:mm tt")</span>
                    </div>
                    <h6 class="font-weight-700 mb-1">@note.Title</h6>
                    <p class="mb-0 text-secondary small">@note.Message</p>
                </div>
            }
        </div>
    }
</div>

@code {
    private List<NotificationItem>? notifications;

    protected override async Task OnInitializedAsync()
    {
        Config.OnConfigChanged += HandleConfigChanged;
        await LoadNotifications();
    }

    private async Task LoadNotifications()
    {
        notifications = await NotificationService.GetNotificationsAsync();
        StateHasChanged();
    }

    private async void HandleConfigChanged()
    {
        await InvokeAsync(async () =>
        {
            await LoadNotifications();
        });
    }

    private string GetCategoryBadge(string category) => category switch
    {
        "Success" => "badge-success",
        "Warning" => "badge-warning",
        "Alert" => "badge-danger",
        _ => "badge-info"
    };

    public void Dispose()
    {
        Config.OnConfigChanged -= HandleConfigChanged;
    }
}
